# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# --- Application ---
APP_ENV=dev
SECRET_KEY=change-me-with-at-least-32-random-characters

# --- Données (port hôte 5433 : un PostgreSQL natif Windows occupe souvent le 5432) ---
# Identifiants des conteneurs Docker (docker-compose.yml les lit ici) — à changer hors dev.
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tender
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5433/tender
TEST_DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5433/tender_test
REDIS_URL=redis://localhost:6379/0

# --- Stockage objet (MinIO en local, Cloudflare R2 en prod) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=tender-ai
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345

# --- Sécurité ---
# En staging/prod : COOKIE_SECURE=true obligatoire, SECRET_KEY générée (openssl rand -hex 32).
COOKIE_SECURE=false
# IP(s) du relais autorisées à transmettre X-Forwarded-For ("*" = réseau Docker fermé).
TRUSTED_PROXY_IPS=*

# --- IA ---
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_STRONG=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Recherche web ---
TAVILY_API_KEY=

# --- Email de notification ---
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# --- Monitoring ---
SENTRY_DSN=

# --- Frontend ---
API_URL=http://localhost:8000
